package stylesheet

import "aoc-runner/views/common"

templ Stylesheet() {
	@common.Layout("Stylesheet") {
		<h1>Design Sheet</h1>
		<p>A sandbox of elements to style. No classes or styles included.</p>
		<!-- Typography -->
		<section>
			<h2>Typography</h2>
			<h1>H1 Heading</h1>
			<p>Lead / subtitle text goes here.</p>
			<h2>H2 Heading</h2>
			<p>
				Body paragraph with <strong>strong</strong>, <em>emphasis</em>, 
				<a href="#">a link</a>, and <code>inline code</code>.
			</p>
			<h3>H3 Heading</h3>
			<ul>
				<li>Unordered list item</li>
				<li>Another item</li>
			</ul>
			<ol>
				<li>Ordered list item</li>
				<li>Another item</li>
			</ol>
			<blockquote>Blockquote — “Style me to match your brand.”</blockquote>
		</section>
		<!-- Buttons -->
		<section>
			<h2>Buttons</h2>
			<button class="btn">Default</button>
			<button class="btn success">Success</button>
			<button class="btn link">Link</button>
		</section>
		<!-- Inputs & Controls -->
		<section>
			<h2>Forms & Controls</h2>
			<label>
				Text input
				<input type="text" placeholder="Your name"/>
			</label>
			<label>
				Email
				<input class="input" type="email" placeholder="you@example.com"/>
			</label>
			<label>
				Password
				<input type="password" placeholder="••••••••"/>
			</label>
			<label>
				Textarea
				<textarea rows="4" placeholder="Write something…"></textarea>
			</label>
			<label>
				Select
				<select>
					<option>Choose one…</option>
					<option>Option A</option>
					<option>Option B</option>
				</select>
			</label>
			<div>
				<label><input type="checkbox"/> Remember me</label>
				<label><input type="checkbox" checked/> Subscribe</label>
				<label><input type="checkbox" disabled/> Disabled</label>
			</div>
			<div>
				<label><input type="radio" name="plan" checked/> Basic</label>
				<label><input type="radio" name="plan"/> Pro</label>
				<label><input type="radio" name="plan" disabled/> Enterprise</label>
			</div>
		</section>
		<!-- Table -->
		<section>
			<h2>Table</h2>
			<table>
				<thead>
					<tr>
						<th>User</th>
						<th>Role</th>
						<th>Status</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td>Ana</td>
						<td>Admin</td>
						<td>Active</td>
						<td>
							<button>Edit</button>
							<button>Delete</button>
						</td>
					</tr>
					<tr>
						<td>Ben</td>
						<td>Editor</td>
						<td>Pending</td>
						<td>
							<button>Edit</button>
							<button disabled>Delete</button>
						</td>
					</tr>
				</tbody>
			</table>
		</section>
		<!-- Cards, Badges, Alerts -->
		<section>
			<h2>Cards, Badges, Alerts</h2>
			<div>
				<h3>Card Title</h3>
				<p>Short description about this card content goes here.</p>
				<button>Secondary</button>
				<button>Primary</button>
			</div>
			<p>Badge examples: <span>Neutral</span> <span>Success</span> <span>Warning</span></p>
			<div>Info: This is an informational alert.</div>
			<div>Success: Changes saved!</div>
			<div>Warning: Check your inputs.</div>
			<div>Error: Something went wrong.</div>
		</section>
		<!-- Tabs -->
		<section>
			<h2>Tabs</h2>
			<div>
				<button>Overview</button>
				<button>Details</button>
				<button>Settings</button>
			</div>
			<div>
				<p>Tab panel content.</p>
			</div>
		</section>
		<!-- Modal structure -->
		<section>
			<h2>Modal</h2>
			<button>Open Modal</button>
			<div>
				<div>
					<h3>Modal Title</h3>
					<p>This is modal content.</p>
					<button>Cancel</button>
					<button>Confirm</button>
				</div>
			</div>
		</section>
	}
}
